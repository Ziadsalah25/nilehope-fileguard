# Safe template: secret fields below are intentionally blank.
# For a fresh local test only, scripts/configure_stack.py creates .env with random credentials and refuses to overwrite an existing file.
# Never commit or attach .env. Keep production secrets in the organization's protected secret store.
# See docs/BEGINNER-GUIDE-AR.md, chapter 33, for each setting and its purpose.
MYSQL_DATABASE=nilehope_fileguard
MYSQL_USER=dlp_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SECRET_KEY=
ENROLL_TOKEN=
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
FC_ENV=testing
CONSOLE_ENVIRONMENT=test
PUBLIC_CONSOLE_URL=http://localhost:8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=13306
UPLOAD_APPROVAL_ENABLED=0

# Optional runtime switches. Keep writes and remote commands disabled by default.
ENABLE_REMOTE_COMMANDS=0
ENABLE_DIRECTORY_WRITES=0
STAFF_REQUESTS_ENABLED=0
ENROLLMENT_ENABLED=1
HOSPITAL_SHARE_PATH=
# SERVICE_ROLE and UPLOAD_STORAGE_ROOT are assigned per service in docker-compose.yml; do not override them here.

# Optional directory settings are described in chapter 33. Leave them unset unless LDAPS is configured.
# LDAP_URI=ldaps://dc.example.local:636
# LDAP_BIND_DN=
# LDAP_PASSWORD=
# LDAP_BASE_DN=
# AD_GROUP_BASE=
# LDAP_CA_CERT_FILE=

# Windows direct HTTPS settings live in a protected runtime JSON configuration, not this Docker sample.
# Never store private key contents in this file.
