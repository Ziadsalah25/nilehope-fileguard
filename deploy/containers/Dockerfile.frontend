FROM node:22-alpine AS builder
WORKDIR /frontend
COPY apps/console/package.json apps/console/package-lock.json ./
RUN npm ci
COPY apps/console ./
RUN npm run build

FROM nginx:1.28-alpine
COPY deploy/containers/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder --chown=nginx:nginx /frontend/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s CMD wget -Y off -q -O /dev/null http://127.0.0.1:8080/frontend-health || exit 1
